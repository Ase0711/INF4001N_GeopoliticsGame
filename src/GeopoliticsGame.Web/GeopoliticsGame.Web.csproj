<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fdc4b415-2308-4e8c-96ca-56c64c206de5</UserSecretsId>
   
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeopoliticsGame.Core\GeopoliticsGame.Core.csproj" />
  </ItemGroup>

  <!-- MongoDB (the NoSQL database). Restored automatically by Visual Studio / `dotnet restore`. -->
  <ItemGroup Condition="'$(NoMongo)' != 'true'">
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(NoMongo)' == 'true'">
    <DefineConstants>$(DefineConstants);NO_MONGO</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NoMongo)' == 'true'">
    <Compile Remove="Infrastructure\Mongo\**" />
  </ItemGroup>

</Project>
