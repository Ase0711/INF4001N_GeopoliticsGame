@model DashboardViewModel
@{
    ViewData["Title"] = "My games";
    var statuses = new[] { ("", "All"), ("active", "In progress"), ("won", "Won"), ("lost", "Lost") };
    var sorts = new[] { ("recent", "Recently played"), ("oldest", "Oldest first"), ("rounds", "Most rounds"), ("countries", "Most countries held") };
}

<div class="row g-4">
    <div class="col-lg-4 order-lg-2">
        <div class="geo-card p-4 sticky-lg-top" style="top: 1rem">
            <h2 class="h5 mb-3">New campaign</h2>
            <partial name="_NewGameForm" model="Model.NewGame" />
        </div>
    </div>

    <div class="col-lg-8 order-lg-1">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <h1 class="h3 mb-0">My games</h1>
            <span class="text-secondary small">@Model.Games.Count of @Model.TotalGames shown</span>
        </div>

        <form method="get" asp-action="Index" class="geo-card p-3 mb-3 row g-2 align-items-end" role="search">
            <div class="col-sm-5">
                <label for="q" class="form-label small mb-1">Search by country</label>
                <input type="search" id="q" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="e.g. Brazil" />
            </div>
            <div class="col-sm-3">
                <label for="status" class="form-label small mb-1">Status</label>
                <select id="status" name="status" class="form-select form-select-sm">
                    @foreach (var (value, label) in statuses)
                    {
                        <option value="@value" selected="@(string.Equals(Model.Status ?? "", value, StringComparison.OrdinalIgnoreCase))">@label</option>
                    }
                </select>
            </div>
            <div class="col-sm-3">
                <label for="sort" class="form-label small mb-1">Sort</label>
                <select id="sort" name="sort" class="form-select form-select-sm">
                    @foreach (var (value, label) in sorts)
                    {
                        <option value="@value" selected="@(Model.Sort == value)">@label</option>
                    }
                </select>
            </div>
            <div class="col-sm-1 d-grid">
                <button type="submit" class="btn btn-sm btn-outline-light">Go</button>
            </div>
        </form>

        @if (Model.TotalGames == 0)
        {
            <div class="geo-card p-5 text-center">
                <div class="display-4">🗺️</div>
                <p class="mt-3 mb-0">No campaigns yet. Choose a country to start your first one.</p>
            </div>
        }
        else if (Model.Games.Count == 0)
        {
            <div class="geo-card p-4 text-center text-secondary">
                No games match those filters. <a asp-action="Index">Clear filters</a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var g in Model.Games)
                {
                    <div class="col-sm-6 col-xl-4"><partial name="_GameCard" model="g" /></div>
                }
            </div>
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
