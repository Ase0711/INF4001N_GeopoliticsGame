@model GameSummary
@{
    var (badge, label) = Model.Status switch
    {
        GameStatus.Won => ("bg-success", "Won"),
        GameStatus.Lost => ("bg-danger", "Lost"),
        _ => Model.IsYourTurn ? ("bg-primary", "Your turn") : ("bg-secondary", "In progress")
    };
}
<a class="geo-card game-card d-block h-100 text-decoration-none" asp-controller="Games" asp-action="Play" asp-route-id="@Model.Id">
    <div class="d-flex justify-content-between align-items-start">
        <span class="display-flag">@Model.CountryFlag</span>
        <span class="badge @badge">@label</span>
    </div>
    <h3 class="h6 mt-2 mb-1 text-light">@Model.CountryName</h3>
    <div class="small text-secondary">Commander @Model.OwnerUsername</div>
    <div class="progress geo-progress my-2" role="progressbar" aria-label="Countries held"
         aria-valuenow="@Model.CountriesHeld" aria-valuemin="0" aria-valuemax="@GameEngine.CountriesPerGame">
        <div class="progress-bar" style="width:@(Model.CountriesHeld * 100 / GameEngine.CountriesPerGame)%"></div>
    </div>
    <div class="d-flex justify-content-between small text-secondary">
        <span>@Model.CountriesHeld/@GameEngine.CountriesPerGame countries · @Model.SoldiersHeld soldiers</span>
        <span>Round @Model.Round</span>
    </div>
    <div class="small text-secondary mt-1">Updated @Model.UpdatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</div>
</a>
