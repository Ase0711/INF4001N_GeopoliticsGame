@model int
@{
    ViewData["Title"] = Model == 404 ? "Not found" : $"Error {Model}";
    var message = Model switch
    {
        404 => "We couldn't find that page or game. It may never have existed.",
        403 => "You don't have permission to do that.",
        429 => "Too many attempts. Please wait a minute and try again.",
        _ => "Something went wrong."
    };
}
<div class="text-center py-5">
    <div class="display-1">@(Model == 404 ? "🗺️" : "⚠️")</div>
    <h1 class="h2 mt-3">@Model</h1>
    <p class="text-secondary">@message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to base</a>
</div>
